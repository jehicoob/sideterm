{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "moduleResolution": "node",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "outDir": "dist", "rootDir": "src", "types": ["node"],
    "noEmitOnError": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
